          <mxGeometry x="80" y="852" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-3" value="┄┄┄ Dashed green: Response (sync 200 / async 202 / SSE)" style="text;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="874" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-4" value="┄┄┄ Dashed grey: External APIs (Anthropic, LangSmith)" style="text;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="896" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-5" value="🟨 Yellow boxes: secrets / signing — never cross zones" style="text;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#a07020;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="918" width="340" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lg-modes" value="Transport modes per capability:&#10;• mentor-virtual, narrative-build → SSE streaming (TTFB &lt; 800ms)&#10;• feedback, hmw-generate, ideate, experiment-routes, prototype-suggest, experiment-analyze, invoke → sync (≤5s)&#10;• research-assist, full ai-review → async polling (taskId + pollUrl, backoff 1·2·4·8s, ±20% jitter)" style="text;html=1;align=left;fontSize=11;fontFamily=Helvetica;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="450" y="830" width="600" height="110" as="geometry" />
        </mxCell>

        <mxCell id="lg-meta" value="Author: BHIL swarm (researcher · system-architect · security-architect · performance-engineer)&#10;Date: 2026-05-07 · Version: 1.0 · ADR: ADR-011 (Proposed)&#10;Related: ADR-002 (orchestration), ADR-008 (AI integration), ADR-010 (error envelope V1)" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#555555;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
