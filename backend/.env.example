# Backend environment (copy to .env and fill)

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/starteria_db

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# HTTP
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=1mb

AI_SERVICE_URL=http://localhost:8001

# Bridge backend ↔ ai-service (V1 — shared secret only)
# TODO(ADR-011): replace with HMAC-SHA256 signing + timestamp + replay protection per TASK-007.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Same value MUST be configured in ai-service. Prefer AI_SERVICE_TOKEN; falls
# back to BRIDGE_SHARED_SECRET for backward compat. Pick ONE name and use it
# in both backend/.env and ai-service/.env.
BRIDGE_SHARED_SECRET=
AI_SERVICE_TOKEN=

# Storage (TASK-006 — local fs V1)
LOCAL_STORAGE_DIR=./storage
